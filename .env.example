# ─────────────────────────────────────────────────────────────────────────────
# ProGRESS — environment variables
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Neo4j ────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=REPLACE_WITH_A_UNIQUE_LOCAL_PASSWORD

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Enrichment (Story 011) ───────────────────────────────────────────────
# Choose a free-tier provider and paste your API key below.
#
# Provider options:
#   gemini   → https://aistudio.google.com/app/apikey          (Google Gemini 1.5 Flash — free)
#   openai   → https://platform.openai.com/account/api-keys    ($5 free credit)
#   groq     → https://console.groq.com/keys                   (Llama 3 — free tier)
#   together → https://api.together.xyz/settings/api-keys      (Mistral 7B — free tier)
#
LLM_PROVIDER=gemini
LLM_API_KEY=YOUR_FREE_API_KEY_HERE

# Optional: override the default model for the chosen provider
# LLM_MODEL=gemini-1.5-flash
